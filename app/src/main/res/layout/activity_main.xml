<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#151515">
    <LinearLayout android:orientation="vertical" android:padding="20dp" android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:text="Ski Auto Solver 🤖" android:textColor="#FFFFFF" android:textSize="26sp" android:textStyle="bold" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <TextView android:text="Motor experimental de automação de minigames" android:textColor="#AAAAAA" android:textSize="14sp" android:layout_marginTop="4dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>

        <LinearLayout android:orientation="vertical" android:background="@drawable/bg_panel" android:layout_marginTop="20dp" android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:text="Minigame" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <Spinner android:id="@+id/gameSpinner" android:layout_marginTop="8dp" android:layout_width="match_parent" android:layout_height="48dp"/>
            <EditText android:id="@+id/tubeCountEdit" android:hint="Tubos (Water Sort)" android:text="8" android:inputType="number" android:textColor="#FFFFFF" android:textColorHint="#888888" android:layout_marginTop="10dp" android:layout_width="match_parent" android:layout_height="48dp"/>
            <TextView android:text="Você escolhe a mecânica. O bot não precisa adivinhar o jogo." android:textColor="#AAAAAA" android:textSize="12sp" android:layout_marginTop="6dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        </LinearLayout>

        <LinearLayout android:orientation="vertical" android:background="@drawable/bg_panel" android:layout_marginTop="14dp" android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:text="Estado" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <TextView android:id="@+id/statusText" android:text="Preparando..." android:textColor="#AAAAAA" android:layout_marginTop="8dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <Button android:id="@+id/overlayButton" android:text="Ativar botão flutuante" android:layout_marginTop="10dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <Button android:id="@+id/captureButton" android:text="Permitir captura da tela" android:layout_marginTop="8dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <Button android:id="@+id/accessButton" android:text="Ativar serviço de toque" android:layout_marginTop="8dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        </LinearLayout>

        <LinearLayout android:orientation="vertical" android:background="@drawable/bg_panel" android:layout_marginTop="14dp" android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:text="Modo de execução" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <Switch android:id="@+id/autoSwitch" android:text="Auto Solver" android:textColor="#FFFFFF" android:layout_marginTop="4dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <TextView android:text="Nesta versão, o executor só age quando houver uma ação produzida pelo solver." android:textColor="#AAAAAA" android:textSize="12sp" android:layout_marginTop="4dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
